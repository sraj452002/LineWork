# Settings for the Linework API (`npm start` in backend/). Copy to backend/.env for development;
# on a host (Render…), set them in its environment instead.
# There are no accounts and no storage: nobody signs in, and files stay in each person's browser.

# Port and address to listen on.
PORT=8787
HOST=0.0.0.0

# What the server keeps (workflows, their credentials and runs, published apps) is in memory and goes
# when it restarts; the app sends its files again each time it opens. A local folder keeps it instead
# (relative to backend/), on a machine with a lasting disk.
DATA_DIR=

# Workflows: the secret their saved credentials (API keys, tokens) are encrypted with. Any long random
# text. Without it, a key the server makes when it starts is used.
FLOW_SECRET=

# AI: your Anthropic API key, the model, and requests per day (0 = no limit).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Also (or instead) NVIDIA's models (build.nvidia.com → an API key, nvapi-…): people pick one in the AI chat.
# NVIDIA_MODEL can list several, comma-separated (each becomes a choice).
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b
AI_DAILY_LIMIT=0

# Behind a reverse proxy or a host's load balancer, trust its X-Forwarded-* headers: the number of
# proxies in front. On Render behind the frontend's Netlify proxy that's 2 (Netlify, then Render's).
TRUST_PROXY=

# The frontend's public address (e.g. https://linework.netlify.app): its pages may make changes through
# its /api proxy. Without it, the address each request arrives at is used (fine in development).
APP_URL=

# The Database view connects to databases through this server. By default it refuses private and local
# addresses (localhost, 10.x, 192.168.x, cloud metadata…), so it can't be used to reach this machine's network.
# Set to 1 when the server runs inside your network and should reach databases there.
DB_ALLOW_PRIVATE=0
