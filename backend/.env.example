# Settings for the Linework API (`npm start` in backend/). Copy to backend/.env for development;
# on a host (Render…), set them in its environment instead.

# Port and address to listen on.
PORT=8787
HOST=0.0.0.0

# Where the data is kept: Google Drive, signed in one of two ways (there is no database).
# 1. Your own Drive: an OAuth client ("Desktop app", Drive API on), then `npm run drive-auth` for the token.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# 2. Or a service account: its JSON key (the JSON itself, or a path to the file), with the folder in a Shared Drive.
GOOGLE_SERVICE_ACCOUNT_KEY=
# The Drive folder. With your own Drive, leave it empty the first time: the server makes "Linework data" and prints its id.
GOOGLE_DRIVE_FOLDER_ID=
# Instead of Drive, a local folder (relative to the project), for development.
DATA_DIR=

# Allow anyone to create an account. With false, nobody new can sign up.
ALLOW_SIGNUP=true

# AI: your Anthropic API key, the model, and requests per account per day (0 = no limit).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=50

# Behind a reverse proxy or a host's load balancer, trust its X-Forwarded-* headers so cookies are
# marked Secure on HTTPS and sign-in limits see the visitor's address: the number of proxies in front.
# On Render behind the frontend's Netlify proxy that's 2 (Netlify, then Render's load balancer).
TRUST_PROXY=

# The frontend's public address (e.g. https://linework.netlify.app): email links, share links and
# Google/GitHub sign-in point there, and its pages may make changes through its /api proxy.
# Without it, the address each request arrives at is used (fine in development, through Vite's proxy).
APP_URL=

# Let people use the app without an account (files stay in their browser). Off: sign-in is required.
ALLOW_LOCAL_MODE=false

# The Database view connects to databases through this server. By default it refuses private and local
# addresses (localhost, 10.x, 192.168.x, cloud metadata…), so it can't be used to reach this machine's network.
# Set to 1 when the server runs inside your network and should reach databases there.
DB_ALLOW_PRIVATE=0

# Email, for confirming new accounts and resetting passwords. Either Resend's API key, or an SMTP URL
# like smtps://user:password@smtp.example.com:465. MAIL_FROM is the sender, e.g. Linework <hi@example.com>.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=
# New accounts must confirm their email: on when email is set up, unless this is false.
REQUIRE_EMAIL_VERIFICATION=

# "Continue with Google": an OAuth client (Google Cloud console → APIs & Services → Credentials,
# type "Web application") with the redirect URI <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub": an OAuth app (GitHub → Settings → Developer settings → OAuth Apps) with the
# callback URL <APP_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
