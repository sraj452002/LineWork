# Settings for `npm start` (the Linework server). Set them in your host's environment.

# Port and address to listen on.
PORT=8787
HOST=0.0.0.0

# Where the SQLite database lives (relative to the project). Keep it on a persistent disk.
DATABASE_PATH=data/linework.db

# The built app to serve (`npm run build` makes dist/). Set to empty to serve only /api.
PUBLIC_DIR=dist

# Allow anyone to create an account. With false, nobody new can sign up.
ALLOW_SIGNUP=true

# AI: your Anthropic API key, the model, and requests per account per day (0 = no limit).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=50

# Behind a reverse proxy or a host's load balancer (Render, Railway, Fly.io), trust its
# X-Forwarded-* headers so cookies are marked Secure on HTTPS: the number of proxies, usually 1.
TRUST_PROXY=
