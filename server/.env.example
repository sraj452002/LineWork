# Settings for `npm start` (the Linework server). Set them in your host's environment.

# Port and address to listen on.
PORT=8787
HOST=0.0.0.0

# Where the SQLite database lives (relative to the project). Keep it on a persistent disk.
DATABASE_PATH=data/linework.db

# The built app to serve (`npm run build` makes dist/). Set to empty to serve only /api.
PUBLIC_DIR=dist

# Allow anyone to create an account. With false, nobody new can sign up.
ALLOW_SIGNUP=true

# AI: your Anthropic API key, the model, and requests per account per day (0 = no limit).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=50

# Behind a reverse proxy or a host's load balancer (Render, Railway, Fly.io), trust its
# X-Forwarded-* headers so cookies are marked Secure on HTTPS: the number of proxies, usually 1.
TRUST_PROXY=

# The site's public address, used in email links and Google/GitHub sign-in (e.g. https://linework.example.com).
# Without it, the address each request arrives at is used.
APP_URL=

# Let people use the app without an account (files stay in their browser). Off: sign-in is required.
ALLOW_LOCAL_MODE=false

# The Database view connects to databases through this server. By default it refuses private and local
# addresses (localhost, 10.x, 192.168.x, cloud metadata…), so it can't be used to reach this machine's network.
# Set to 1 when the server runs inside your network and should reach databases there.
DB_ALLOW_PRIVATE=0

# Email, for confirming new accounts and resetting passwords. Either Resend's API key, or an SMTP URL
# like smtps://user:password@smtp.example.com:465. MAIL_FROM is the sender, e.g. Linework <hi@example.com>.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=
# New accounts must confirm their email: on when email is set up, unless this is false.
REQUIRE_EMAIL_VERIFICATION=

# "Continue with Google": an OAuth client (Google Cloud console → APIs & Services → Credentials,
# type "Web application") with the redirect URI <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub": an OAuth app (GitHub → Settings → Developer settings → OAuth Apps) with the
# callback URL <APP_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
